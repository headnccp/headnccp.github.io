---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import { formatDate, formatDateTime, formatTime } from "../../lib/site";

export async function getStaticPaths() {
  return (await getCollection("events")).map((event) => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props as { event: CollectionEntry<"events"> };
const { Content } = await render(event);
const { start, end, location, registration } = event.data;
const sameDay = end && formatDate(start) === formatDate(end);
---
<Base title={event.data.title} description={event.data.summary} image={event.data.cover}>
  <article class="container narrow">
    <header class="article-head">
      <p class="breadcrumb"><a href="/events/">Events</a></p>
      <h1>{event.data.title}</h1>
      {event.data.cover && <img class="article-cover" src={event.data.cover} alt="">}
    </header>
    <ul class="facts">
      <li><strong>When</strong> {formatDateTime(start)}{end && ` – ${sameDay ? formatTime(end) : formatDateTime(end)}`}</li>
      {location && <li><strong>Where</strong> {location}</li>}
    </ul>
    {registration && (
      <div class="actions"><a class="btn" href={registration} target="_blank" rel="noopener">Register</a></div>
    )}
    <div class="prose"><Content /></div>
    {event.data.photos.length > 0 && <h2>Photos</h2>}
    <PhotoGrid photos={event.data.photos} label={event.data.title} />
  </article>
</Base>
